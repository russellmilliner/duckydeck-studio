<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language>
<language name="duckyScript 3"
          version="1"
          kateversion="5.79"
          section="Scripts"
          extensions="*.txt;*.ds;*.ducky"
          mimetype="text/x-duckyscript3"
          author="DuckyDeck Studio"
          license="GPL-3.0-or-later">
  <highlighting>
